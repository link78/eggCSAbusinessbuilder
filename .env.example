# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# PostgreSQL connection string.
# For local development:  postgresql://localhost/egg_csa
# For Supabase:           postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=postgresql://localhost/egg_csa
# Optional — set DATABASE_SSL=false for local PostgreSQL if needed.
# DATABASE_SSL=false

# Secret used to sign session cookies.
# Required in production — use a long, random string (e.g. openssl rand -hex 32).
SESSION_SECRET=replace-with-a-long-random-string

# Optional — defaults to 3000
# PORT=3000

# Stripe Billing integration.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_URL=http://localhost:3000
#
# Optional pre-created recurring Price IDs. If omitted, checkout falls back to
# dynamic monthly Stripe prices based on the selected plan total.
# STRIPE_PRICE_SMALL_FAMILY=price_...
# STRIPE_PRICE_FAMILY=price_...
# STRIPE_PRICE_SOLO_COUPLE=price_...
# STRIPE_PRICE_CUSTOM=price_...

# Optional — set to "production" to enable secure cookies
# NODE_ENV=production
