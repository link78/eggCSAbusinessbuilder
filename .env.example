# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# PostgreSQL connection string.
# For local development:  postgresql://localhost/egg_csa
# For Supabase:           postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=postgresql://localhost/egg_csa

# Secret used to sign session cookies.
# Required in production — use a long, random string (e.g. openssl rand -hex 32).
SESSION_SECRET=replace-with-a-long-random-string

# Optional — defaults to 3000
# PORT=3000

# Optional — set to "production" to enable secure cookies
# NODE_ENV=production
